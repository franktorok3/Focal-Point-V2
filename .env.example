# IONOS Mail Basic credentials used only by the server-side contact route.
IONOS_SMTP_USER=hello@focalpointny.com
IONOS_SMTP_PASSWORD=
IONOS_SMTP_HOST=smtp.ionos.com
IONOS_SMTP_PORT=587

# CONTACT_TO can be frank@focalpointny.com, hello@focalpointny.com, or both
# addresses separated by a comma. CONTACT_FROM must be an authenticated IONOS
# mailbox or an address that mailbox is authorized to send as.
CONTACT_TO=hello@focalpointny.com
CONTACT_FROM=hello@focalpointny.com

# Shared rate-limit storage for the public contact endpoint.
# Create a Vercel Marketplace Redis database and add these as server-only secrets.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_APP_URL=https://www.focalpointny.com
